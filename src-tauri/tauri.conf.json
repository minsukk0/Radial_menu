{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Radial Menu",
  "version": "0.1.0",
  "identifier": "com.radialmenu.app",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "menu",
        "title": "Radial Menu",
        "width": 680,
        "height": 680,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "url": "src/menu/index.html"
      },
      {
        "label": "add-item",
        "title": "항목 추가",
        "width": 840,
        "height": 640,
        "resizable": true,
        "decorations": true,
        "visible": false,
        "url": "src/dialogs/add-item/index.html"
      },
      {
        "label": "approve",
        "title": "관리자 실행 승인",
        "width": 480,
        "height": 320,
        "resizable": false,
        "decorations": true,
        "alwaysOnTop": true,
        "visible": false,
        "url": "src/dialogs/approve/index.html"
      },
      {
        "label": "category-settings",
        "title": "상위 메뉴 설정",
        "width": 840,
        "height": 640,
        "resizable": false,
        "decorations": true,
        "visible": false,
        "url": "src/dialogs/category-settings/index.html"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
